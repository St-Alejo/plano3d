# Copia este archivo a .env (docker compose lo lee automáticamente)
POSTGRES_USER=plano3d
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=plano3d

S3_ACCESS_KEY=plano3d
S3_SECRET_KEY=cambia-esta-clave-s3

PLANO3D_S3_BUCKET=plano3d
PLANO3D_LOG_LEVEL=INFO
PLANO3D_CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]

WEB_PORT=8080
